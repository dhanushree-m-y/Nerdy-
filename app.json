{
  "expo": {
    "name": "NUMI",
    "slug": "numi-the-world-runs-on-math",
    "owner": "dhanushree00",
    "description": "NUMI – The World Runs on Math. A K–5 math adventure where learning repairs the world.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fdf5e8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.numi.worldrunsonmath",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NUMI listens only when you tap the microphone, so you can ask for help or explain your thinking.",
        "NSSpeechRecognitionUsageDescription": "NUMI turns what you say into words so it can help with the current puzzle."
      }
    },
    "android": {
      "package": "com.numi.worldrunsonmath",
      "adaptiveIcon": {
        "backgroundColor": "#2fa08a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "NUMI – The World Runs on Math",
      "themeColor": "#2fa08a",
      "backgroundColor": "#fdf5e8"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fdf5e8",
          "dark": {
            "backgroundColor": "#fdf5e8"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b8eec87e-e295-4b50-868c-ca7dd26ba878"
      }
    }
  }
}
